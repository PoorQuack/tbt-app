{
  "name": "tbt-app",
  "version": "1.0.0",
  "description": "Zero-Cost Mobile-First Internal Toolbox Talk (TBT) Web App on Cloudflare Pages + D1",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=tbt-db --local",
    "build": "echo \"No build required for vanilla frontend\"",
    "d1:create": "wrangler d1 create tbt-db",
    "migrate:local": "wrangler d1 migrations apply tbt-db --local",
    "migrate:remote": "wrangler d1 migrations apply tbt-db --remote",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
